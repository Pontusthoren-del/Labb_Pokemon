@model Labb__Pokémon.Models.PokemonViewModel

@{
    ViewData["Title"] = Model.Name;
    var primaryType = Model.Types.FirstOrDefault() ?? "normal";
}

<div class="card-frame" data-type="@primaryType">
    <div class="card-inner">
        <div class="card-name">@Model.Name</div>

        <div class="card-screen">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="@Model.Name" />
            }
        </div>
        @if (Model.EvolutionSteps.Count > 1)
        {
            <div class="evolution-strip">
                @for (int i = 0; i < Model.EvolutionSteps.Count; i++)
                {
                    var step = Model.EvolutionSteps[i];

                    <a asp-controller="Pokemon" asp-action="Details" asp-route-name="@step.Name"
                       class="evolution-step @(step.IsCurrent ? "current" : "")">
                        <img src="@step.ImageUrl" alt="@step.Name" />
                        <p>@step.Name</p>
                    </a>

                    @if (i < Model.EvolutionSteps.Count - 1)
                    {
                        <span class="evolution-arrow">→</span>
                    }
                }
            </div>
        }

        <div class="card-badges">
            @foreach (var type in Model.Types)
            {
                <span class="type-badge" data-type="@type">@type</span>
            }
        </div>

        <div class="card-meta">
            <div><strong>@Model.Height.ToString("0.#") m</strong>Längd</div>
            <div><strong>@Model.Weight.ToString("0.#") kg</strong>Vikt</div>
        </div>

        <div>
            @foreach (var stat in Model.Stats)
            {
                var pct = Math.Min(100, (stat.Value / 150.0) * 100);
                <div class="stat-row">
                    <div class="stat-label">
                        <span>@stat.Key.Replace("-", " ")</span>
                        <span>@stat.Value</span>
                    </div>
                    <div class="stat-bar-track">
                        <div class="stat-bar-fill" style="width:@pct.ToString("0")%"></div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<a class="btn-poke" asp-controller="Pokemon" asp-action="Search">← Tillbaka</a>